#!/usr/bin/env bash
# pre-commit: 阻止密钥/敏感信息进入仓库
set -uo pipefail

PATTERNS=(
    'sk-[A-Za-z0-9]{20,}'                       # OpenAI 风格
    'ghp_[A-Za-z0-9]{20,}'                      # GitHub PAT
    'github_pat_[A-Za-z0-9_]{20,}'
    'AKIA[0-9A-Z]{16}'                          # AWS
    '-----BEGIN [A-Z ]*PRIVATE KEY-----'
    'xox[baprs]-[A-Za-z0-9-]{10,}'              # Slack
    '(?i)(token|secret|passwd|password|api[_-]?key)[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_\-]{12,}'
)

# 已知误报：匹配到 PATTERNS 但属于标准配置键，值不是凭据。
# 格式为 grep -E 正则，匹配到的行会被跳过。
ALLOWLIST=(
    # xdg-desktop-portal 的 Secret 门户，值为后端名（gnome-keyring / kwallet 等）
    'org\.freedesktop\.impl\.portal\.Secret[[:space:]]*='
    # 输入法/终端里关于密码输入的布尔开关
    '(AllowInputMethod|ShowPreedit)ForPassword'
    '^[[:space:]]*#?[[:space:]]*password-character[[:space:]]*='
)

fail=0
# 仅扫描本次暂存的文本文件
while IFS= read -r -d '' f; do
    # 跳过二进制
    if ! grep -Iq . "$f" 2>/dev/null; then continue; fi
    for pat in "${PATTERNS[@]}"; do
        hits=$(grep -nP "$pat" "$f" 2>/dev/null) || continue
        [ -n "$hits" ] || continue

        # 过滤白名单中的已知误报行
        for allow in "${ALLOWLIST[@]}"; do
            hits=$(printf '%s\n' "$hits" | grep -vP "$allow")
        done
        [ -n "$hits" ] || continue

        printf '\033[31m[pre-commit] 疑似敏感信息: %s\033[0m\n%s\n' "$f" "$hits" >&2
        fail=1
    done
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "$fail" -ne 0 ]; then
    cat >&2 <<'EOF'

提交已阻止。请处理以上内容后重试：
  * 把明文凭据换成环境变量（$TOKEN / ${VAR:?}）
  * 或把该文件加入 .gitignore 并 git rm --cached <file>
确认无误确要提交时: git commit --no-verify
EOF
    exit 1
fi
