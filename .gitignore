# ---- 绝不纳入版本控制 ----
# 备份/生成物
*~
*.bak
*.bak.*
*.backup*
config.kdl.bak-*
nvim.old.*

# 注意: .config/niri/dms/colors.kdl 与 wpblur.kdl 由 DMS 生成，
# 但 config.kdl 无条件 include 它们，缺失会导致 niri 无法启动。
# 因此仓库保留一份快照作为兜底，不要把它们加进 .gitignore。

# 密钥与凭据
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/known_hosts
**/.netrc
**/.npmrc
**/.git-credentials
**/.ssh/**
**/.gnupg/**
**/.pki/**

# 含 token 的个人运维脚本
dotfiles-user/.local/bin/bot
dotfiles-user/.local/bin/botrm
dotfiles-user/.local/bin/botw

# 二进制与大体积资产
dotfiles-shorin/.local/bin/bad-apple
dotfiles-user/.local/bin/uv
dotfiles-user/.local/bin/uvx
dotfiles-user/.local/bin/btop
dotfiles-user/Pictures/**
*.pkg.tar.zst
*.AppImage

# 运行时/缓存
**/.cache/**
**/.dsh/**
**/.dsh-tui/**
**/node_modules/**
**/__pycache__/**
*.pyc
*.log
